#!/usr/bin/env bash
# Copyright (C) 2021-2026 Bytedance Ltd. and/or its affiliates

find_volclava_top()
{
    package=${DPKG_MAINTSCRIPT_PACKAGE:-volclava}
    env_file=$(dpkg-query -L "$package" 2>/dev/null \
        | sed -n '\#/etc/volclava\.sh$#p' \
        | head -n 1)
    if [ -z "$env_file" ]; then
        return 1
    fi

    dirname "$(dirname "$env_file")"
}

VOLC_TOP=$(find_volclava_top || true)

case "$1" in
    remove|deconfigure|upgrade|failed-upgrade)
        # Daemons live in sbin; also stop legacy copies from older installs in bin.
        if [ -n "$VOLC_TOP" ]; then
            if [ -x "${VOLC_TOP}/sbin/bhist-speedup-server" ]; then
                LSF_ENVDIR="${VOLC_TOP}/etc" \
                    "${VOLC_TOP}/sbin/bhist-speedup-server" stop \
                    > /dev/null 2>&1 || true
            elif [ -x "${VOLC_TOP}/bin/bhist-speedup-server" ]; then
                LSF_ENVDIR="${VOLC_TOP}/etc" \
                    "${VOLC_TOP}/bin/bhist-speedup-server" stop \
                    > /dev/null 2>&1 || true
            fi
            if [ -x "${VOLC_TOP}/sbin/bhist-speedup-loader" ]; then
                LSF_ENVDIR="${VOLC_TOP}/etc" \
                    "${VOLC_TOP}/sbin/bhist-speedup-loader" stop \
                    > /dev/null 2>&1 || true
            elif [ -x "${VOLC_TOP}/bin/bhist-speedup-loader" ]; then
                LSF_ENVDIR="${VOLC_TOP}/etc" \
                    "${VOLC_TOP}/bin/bhist-speedup-loader" stop \
                    > /dev/null 2>&1 || true
            fi
        fi
        ;;
esac

exit 0
