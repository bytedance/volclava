# bhist speedup configuration.
#
# Installed as $LSF_ENVDIR/lsb.hist. Set the two required settings, then
# start the loader and server on the service host. Restart them after
# changing this file.
#
# Optional settings are commented out and show their default; uncomment one
# only to change it. They are listed from the most to the least often
# changed.

# ---------------------------------------------------------------------------
# The following settings are required; the service does not start until both
# are set.
# ---------------------------------------------------------------------------

# Service host and port. Run the loader and server on this host; bhist
# connects to it. The server listens on this port on all IPv4 addresses.
# LSB_BHIST_ENDPOINT=hostname:port

# Database file, as an absolute path on a local disk of the service host.
# Use local SSD storage, not NFS. Stop the loader before changing it.
# LSB_BHIST_DB_PATH=/var/lib/bhist-speedup/bhist-speedup.sqlite

# ---------------------------------------------------------------------------
# The following settings control how far back and how fresh the queryable
# history is.
# ---------------------------------------------------------------------------

# Days of job history bhist can show (1-365). More days need more disk space
# for the database and slow queries down.
# LSB_BHIST_HISTORY_RETENTION=30

# How often the loader checks for new events, in seconds (1-3600). A job
# change shows up in bhist after about this long.
# LSB_BHIST_EVENT_POLL_INTERVAL=5

# ---------------------------------------------------------------------------
# The following settings control how much memory the loader and server may
# use. The defaults suit most hosts; lower them on hosts with little memory.
# ---------------------------------------------------------------------------

# Memory the loader may use for its database cache, in MiB.
# LSB_BHIST_IMPORT_CACHE_SIZE=1024

# Jobs a large query (time range or full history) hands to bhist at a time
# (2000-50000); a job array counts as one job. bhist memory grows with this
# number; lowering it reduces the peak memory of large queries, at the cost
# of slower large queries.
# LSB_BHIST_JOBS_PER_BATCH=10000

# Memory one query may use for its database cache, in MiB. Queries by job ID
# use far less; large queries may use all of it.
# LSB_BHIST_QUERY_DB_CACHE_SIZE=256

# Part of the database file one query maps into memory, in MiB. This memory is
# shared by queries and freed by the system when needed. 0 turns it off.
# LSB_BHIST_QUERY_DB_MMAP_SIZE=256

# ---------------------------------------------------------------------------
# The following settings control how many queries run at once and how long
# to wait. The defaults suit most hosts; lower the concurrency on hosts with
# few CPUs.
# ---------------------------------------------------------------------------

# Queries the server runs at the same time (1-128).
# LSB_BHIST_MAX_CONCURRENT_QUERIES=16

# Of those, how many may be large queries: time ranges or the full history
# (1-16, at most LSB_BHIST_MAX_CONCURRENT_QUERIES).
# LSB_BHIST_MAX_CONCURRENT_SCAN_QUERIES=4

# bhist processes one query may run in parallel (1-16).
# LSB_BHIST_MAX_FORMATTERS_PER_QUERY=4

# Queries that may wait while the server is busy (0-4096). Beyond this, bhist
# uses the standard bhist.
# LSB_BHIST_MAX_QUEUED_QUERIES=128

# Seconds bhist waits for the service before using the standard bhist
# (1-3600).
# LSB_BHIST_CONNECT_TIMEOUT=5

# Seconds the server waits for a query request to arrive (1-3600). Raise it
# on slow networks.
# LSB_BHIST_RECEIVE_TIMEOUT=5
