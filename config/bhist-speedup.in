#!/bin/bash
# Copyright (C) 2021-2026 Bytedance Ltd. and/or its affiliates

# chkconfig: 2345 99 01
# description: bhist-speedup loader and server
### BEGIN INIT INFO
# Provides: bhist-speedup
# Required-Start: $local_fs $remote_fs $network
# Required-Stop: $local_fs $remote_fs $network
# Default-Start: 2 3 4 5
# Default-Stop: 0 1 6
# Short-Description: bhist-speedup loader and server
### END INIT INFO

if [ -z "${BASH_VERSION:-}" ]; then
    exec bash "$0" "$@"
fi

usage() {
    echo "Usage: $0 {start|stop|status|restart|rebuild}"
}

if [ "$#" -ne 1 ]; then
    usage >&2
    exit 2
fi
case "$1" in
    -h|--help)
        usage
        exit 0
        ;;
    start|stop|status|restart|rebuild)
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac

# Directory containing lsf.conf. The build fills in the volclava
# installation prefix as the default. If you run this against an
# existing LSF installation instead, set LSF_ENVDIR to the real LSF
# etc directory (for example /opt/lsf/conf) before starting.
LSF_ENVDIR="@prefix@/etc"

# Load the environment: volclava.sh for a volclava installation,
# profile.lsf for a real LSF installation. Either one defines
# LSF_ENVDIR, LSF_BINDIR and friends.
if [ -r "$LSF_ENVDIR/volclava.sh" ]; then
    profile="$LSF_ENVDIR/volclava.sh"
elif [ -r "$LSF_ENVDIR/profile.lsf" ]; then
    profile="$LSF_ENVDIR/profile.lsf"
else
    echo "bhist-speedup: cannot find volclava.sh or profile.lsf in $LSF_ENVDIR (adjust LSF_ENVDIR at the top of this script)" >&2
    exit 1
fi
if ! source "$profile"; then
    echo "bhist-speedup: failed to load $profile" >&2
    exit 1
fi
if [[ "$LSF_ENVDIR" != /* || "$LSF_BINDIR" != /* || "$LSF_SERVERDIR" != /* ]] ||
    [ ! -d "$LSF_ENVDIR" ] || [ ! -d "$LSF_BINDIR" ] ||
    [ ! -d "$LSF_SERVERDIR" ]; then
    echo "bhist-speedup: LSF_ENVDIR, LSF_BINDIR and LSF_SERVERDIR must name absolute directories" >&2
    exit 1
fi
export LSF_ENVDIR LSF_BINDIR LSF_SERVERDIR

# The loader and server are daemons and live in sbin (LSF_SERVERDIR).
loader="$LSF_SERVERDIR/bhist-speedup-loader"
server="$LSF_SERVERDIR/bhist-speedup-server"
if [ ! -x "$loader" ] || [ ! -x "$server" ]; then
    echo "bhist-speedup: loader and server must be executable in $LSF_SERVERDIR" >&2
    exit 1
fi

start() {
    "$loader" "${1:-start}" || return 1
    "$server" start || return 1
}

stop() {
    local result=0

    "$server" stop || result=1
    "$loader" stop || result=1
    return "$result"
}

status() {
    local result=0

    echo "[loader]"
    "$loader" status || result=1
    echo "[server]"
    "$server" status || result=1
    return "$result"
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    status)  status ;;
    restart) stop && start ;;
    rebuild) stop && start rebuild ;;
esac
