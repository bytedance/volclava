#!/bin/bash
# Copyright (C) 2026 Bytedance Ltd. and/or its affiliates
#
# Install or remove the systemd units that run bhist-speedup-loader and
# bhist-speedup-server for the cluster selected by LSF_ENVDIR.
#
# The units carry the cluster environment as static Environment= lines,
# resolved here from volclava.sh or profile.lsf in LSF_ENVDIR. Rerun this
# script after moving the installation or changing its platform directory.

PROG=bhist-speedup-setup
UNIT_DIR=/etc/systemd/system
TARGETS="loader server"
# Each target runs program bhist-speedup-<target> as service
# volclava-bhist-<target>.service.
SERVICES="volclava-bhist-loader volclava-bhist-server"
# Exit statuses a restart cannot fix: usage, configuration, database needs
# clean, already running. Keep in sync with SERVICE_EXIT_* in bhist.service.h.
NO_RESTART_STATUS="64 65 78 79"

usage() {
    echo "Usage: $PROG             install or update the systemd services"
    echo "       $PROG --remove    stop and remove the systemd services"
}

die() {
    echo "$PROG: $*" >&2
    exit 1
}

# A usable environment names absolute directories holding both programs.
environment_ok() {
    [[ "$LSF_ENVDIR" == /* && "$LSF_SERVERDIR" == /* && "$LSF_BINDIR" == /* ]] &&
        [ -x "$LSF_SERVERDIR/bhist-speedup-loader" ] &&
        [ -x "$LSF_SERVERDIR/bhist-speedup-server" ]
}

# Load the cluster environment: volclava.sh first, then profile.lsf for LSF.
# Success is judged by the result, since a profile may report a problem and
# still return 0. Each candidate is tried in a subshell first.
load_environment() {
    local profile

    for profile in "$LSF_ENVDIR/volclava.sh" "$LSF_ENVDIR/profile.lsf"; do
        [ -r "$profile" ] || continue
        if (source "$profile" > /dev/null 2>&1 && environment_ok); then
            source "$profile" > /dev/null 2>&1
            PROFILE=$profile
            return 0
        fi
    done
    die "cannot find bhist speedup for this host in $LSF_ENVDIR/volclava.sh" \
        "or profile.lsf; check that it is installed for this platform"
}

systemd_running() {
    command -v systemctl > /dev/null 2>&1 && [ -d /run/systemd/system ]
}

# Print the LSF_ENVDIR recorded in an installed unit, if any.
unit_envdir() {
    sed -n 's/^Environment="LSF_ENVDIR=\(.*\)"$/\1/p' "$UNIT_DIR/$1.service" \
        2> /dev/null
}

# Drop the time, pid and level fields ls_syslog() writes before a message.
strip_log_prefix() {
    sed -E 's/^[A-Z][a-z]{2} +[0-9]+ [0-9:]+ [0-9]+ [0-9]+ [0-9]+ //'
}

# Stop with the program's own reason when it cannot start on this host.
# Sets RUNNING_PID when an instance already runs.
check_service() {
    local program=bhist-speedup-$1 output status

    output=$("$LSF_SERVERDIR/$program" status 2>&1)
    status=$?
    if [ "$status" -eq 78 ]; then
        echo "$output" | strip_log_prefix >&2
        die "$program cannot run on this host; fix the problem above and" \
            "rerun $PROG"
    fi
    RUNNING_PID=$(echo "$output" | sed -n 's/^pid=//p' | head -n 1)
}

# Write one unit, setting CHANGED when its content differs.
write_unit() {
    local name=volclava-bhist-$1 description=$2 tmp
    local file="$UNIT_DIR/$name.service"

    tmp=$(mktemp "$UNIT_DIR/.$name.service.XXXXXX") || return 1
    {
        echo "# Generated by $PROG from $PROFILE; rerun it instead of editing."
        echo "[Unit]"
        echo "Description=$description"
        echo "Documentation=man:bhist-speedup(1)"
        echo "After=network-online.target remote-fs.target nss-user-lookup.target"
        echo "Wants=network-online.target"
        echo
        echo "[Service]"
        echo "Type=notify"
        echo "Environment=\"LSF_ENVDIR=$LSF_ENVDIR\""
        echo "Environment=\"LSF_SERVERDIR=$LSF_SERVERDIR\""
        echo "Environment=\"LSF_BINDIR=$LSF_BINDIR\""
        if [ -n "$LSF_LIBDIR" ]; then
            echo "Environment=\"LSF_LIBDIR=$LSF_LIBDIR\""
        fi
        echo "ExecStart=$LSF_SERVERDIR/bhist-speedup-$1"
        echo "Restart=on-failure"
        echo "RestartSec=10"
        echo "RestartPreventExitStatus=$NO_RESTART_STATUS"
        echo "TimeoutStopSec=30"
        echo
        echo "[Install]"
        echo "WantedBy=multi-user.target"
    } > "$tmp" && chmod 0644 "$tmp" || {
        rm -f "$tmp"
        return 1
    }
    if cmp -s "$tmp" "$file"; then
        rm -f "$tmp"
        return 0
    fi
    mv -f "$tmp" "$file" || return 1
    CHANGED=1
}

install_units() {
    local name target owner path pid main_pid active="" outside=""

    load_environment
    for path in "$LSF_ENVDIR" "$LSF_SERVERDIR" "$LSF_BINDIR" "$LSF_LIBDIR"; do
        [[ "$path" != *[[:space:]]* ]] ||
            die "installation paths must not contain spaces: $path"
    done
    for name in $SERVICES; do
        owner=$(unit_envdir "$name")
        if [ -n "$owner" ] && [ "$owner" != "$LSF_ENVDIR" ]; then
            die "$name.service already runs the cluster in $owner;" \
                "run $PROG --remove with that LSF_ENVDIR first"
        fi
    done

    for target in $TARGETS; do
        check_service "$target"
        main_pid=$(systemctl show -p MainPID \
            "volclava-bhist-$target.service" 2> /dev/null | cut -d= -f2)
        if [ -n "$RUNNING_PID" ] && [ "$RUNNING_PID" != "$main_pid" ]; then
            outside="$outside $target:$RUNNING_PID"
        fi
    done

    CHANGED=0
    write_unit loader "bhist speedup loader" &&
        write_unit server "bhist speedup server" ||
        die "cannot write the unit files in $UNIT_DIR"
    systemctl daemon-reload || die "systemctl daemon-reload failed"
    systemctl -q enable $SERVICES ||
        die "cannot enable the services; see the systemctl message above"

    echo "Installed volclava-bhist-loader.service and volclava-bhist-server.service."
    for name in $SERVICES; do
        if systemctl -q is-active "$name.service"; then
            active="$active $name"
        fi
    done
    for target in $outside; do
        pid=${target#*:}
        target=${target%%:*}
        echo "bhist-speedup-$target is running outside systemd (pid $pid);" \
            "to hand it to systemd: bhist-admin $target stop, then" \
            "systemctl start volclava-bhist-$target"
    done
    if [ -n "$active" ] && [ "$CHANGED" -eq 1 ]; then
        echo "Restart to apply the update: systemctl restart$active"
    elif [ -z "$active" ]; then
        echo "Start them with: systemctl start $SERVICES"
    fi
}

remove_units() {
    local name owner removed=0 systemd=0

    systemd_running && systemd=1

    for name in $SERVICES; do
        [ -e "$UNIT_DIR/$name.service" ] || continue
        owner=$(unit_envdir "$name")
        if [ -n "$owner" ] && [ "$owner" != "$LSF_ENVDIR" ]; then
            echo "Kept $name.service: it runs the cluster in $owner."
            continue
        fi
        if [ "$systemd" -eq 1 ]; then
            systemctl stop "$name.service" ||
                die "cannot stop $name.service; see the systemctl message above"
        fi
        systemctl -q disable "$name.service" 2> /dev/null
        rm -f "$UNIT_DIR/$name.service" ||
            die "cannot remove $UNIT_DIR/$name.service"
        removed=1
    done
    if [ "$removed" -eq 1 ]; then
        [ "$systemd" -eq 0 ] || systemctl daemon-reload
        echo "Removed the bhist speedup services."
    else
        echo "No bhist speedup services to remove."
    fi
}

case "$#:$1" in
    0:)
        action=install
        ;;
    1:--remove)
        action=remove
        ;;
    1:-h|1:--help)
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac

[ "$(id -u)" -eq 0 ] || die "run as root"
[[ "$LSF_ENVDIR" == /* && -d "$LSF_ENVDIR" ]] ||
    die "LSF_ENVDIR is not set; set it to the directory holding lsf.conf"
LSF_ENVDIR=${LSF_ENVDIR%/}
if [ "$action" = install ]; then
    systemd_running ||
        die "systemd is not running on this host; run bhist-speedup-loader" \
            "and bhist-speedup-server by hand instead"
    install_units
else
    remove_units
fi
